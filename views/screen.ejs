<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Smart Такси</title>
    <link rel="stylesheet" href="/css/screen.css">
</head>
<body>

    <!-- ЗАСТАВКА -->
    <div id="screen-start" class="screen active">
        <div class="logo">SMART ТАКСИ</div>
        <p class="welcome-text">Добро пожаловать.<br>Пока мы в пути, вы можете посмотреть кино.</p>
    </div>

    <!-- РЕКЛАМА -->
    <div id="screen-ad" class="screen">
        <video id="ad-video" playsinline muted></video>
    </div>

    <!-- МЕНЮ -->
    <div id="screen-menu" class="screen">
        <div class="logo">Выберите категорию</div>
        
        <div class="accordion-container">
            <div class="category" id="cat-movies">
                <div class="category-header" onclick="toggleCategory('cat-movies')">
                    <span>🎬 Фильмы</span>
                    <span class="plus">+</span>
                </div>
                <div class="category-content">
                    <div class="grid" id="grid-movies"></div>
                </div>
            </div>

            <div class="category" id="cat-cartoons">
                <div class="category-header" onclick="toggleCategory('cat-cartoons')">
                    <span>🧸 Мультфильмы</span>
                    <span class="plus">+</span>
                </div>
                <div class="category-content">
                    <div class="grid" id="grid-cartoons"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ВЫБРАННЫЙ ФИЛЬМ -->
    <div id="screen-selected" class="screen">
        <div class="selected-icon">🎬</div>
        <h1>Выбран фильм:</h1>
        <h2 id="selected-title">Название</h2>
        <p class="hint">Водитель уже включает его для вас!</p>
        <button onclick="backToMenu()" class="btn-back">← Назад в меню</button>
    </div>

    <!-- ОПЛАТА ПЕРЕВОДОМ -->
    <div id="screen-tips" class="screen">
        <div class="pay-header">
            <h1 class="pay-title">Оплата поездки</h1>
            <p class="pay-subtitle">У вас нет наличных? Переведите стоимость поездки по номеру:</p>
        </div>

        <div class="qr-container">
            <img src="/img/qr/sber-qr.png" alt="QR Сбер" class="qr-image" onerror="this.src='/img/no-cover.jpg'">
        </div>

        <div class="pay-details">
            <div class="phone-number">+7 (989) 782-64-05</div>
            <div class="bank-info">Сбербанк • Зурьят Гозгешева</div>
        </div>

        <div class="review-block">
            <p>Если Вам понравилась поездка, поставьте <span class="stars">5 звезд ⭐⭐⭐⭐⭐</span> в приложении <strong>Maxim</strong>.</p>
            <p class="greeting">Хорошего Вам дня!</p>
        </div>

        <button onclick="backToMenu()" class="btn-back">← Назад в меню</button>
    </div>

    <!-- ЧЕРНЫЙ ЭКРАН -->
    <div id="screen-black" class="screen"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/screen.js"></script>
</body>
</html>

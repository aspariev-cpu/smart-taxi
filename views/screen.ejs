<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Smart Такси</title>
    <link rel="stylesheet" href="/css/screen.css">
    <style>
        /* Стили для экрана слайдшоу */
        #screen-slideshow {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-color: #0f172a; /* Темный фон */
            z-index: 9999;
        }
        #screen-slideshow .slide {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: cover; /* Картинка заполняет весь экран */
            opacity: 0;
            transition: opacity 1.5s ease-in-out;
        }
        #screen-slideshow .slide.active {
            opacity: 1;
        }
        
        /* Стили для текстовых слайдов (оценка, оплата) */
        #screen-slideshow .slide-content {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            padding: 40px;
        }
        /* Убираем лишние отступы у карточек внутри слайдшоу */
        #screen-slideshow .rating-card,
        #screen-slideshow .pay-card {
            margin: 0;
            width: 100%;
            max-width: 800px;
        }
    </style>
</head>
<body>

    <!-- СЛАЙДШОУ (НОВЫЙ ЭКРАН) -->
    <div id="screen-slideshow" class="screen">
        
        <!-- 1. Фотография зарядки (твой slide1.jpg) -->
        <img src="/img/slide1.jpg" class="slide active" alt="Зарядка телефона">
        
        <!-- 2. Оценка поездки -->
        <div class="slide slide-content">
            <div class="rating-card">
                <h1>Оцените поездку</h1>
                <p class="rating-subtitle">Поставьте 5 звезд в приложении Maxim</p>
                <div class="stars-container">
                    <span class="star">⭐</span>
                    <span class="star">⭐</span>
                    <span class="star">⭐</span>
                    <span class="star">⭐</span>
                    <span class="star">⭐</span>
                </div>
                <p class="greeting">Хорошего Вам дня!</p>
            </div>
        </div>

        <!-- 3. QR-код (Оплата) -->
        <div class="slide slide-content">
            <div class="pay-card">
                <h1 class="pay-title">Оплата поездки</h1>
                <div class="tips-content">
                    <div class="qr-container">
                        <img src="/img/qr/sber-qr.png" alt="QR Сбер" class="qr-image" onerror="this.src='/img/no-cover.jpg'">
                    </div>
                    <div class="pay-details">
                        <div class="phone-number">+7 (989) 782-64-05</div>
                        <div class="bank-info">Сбербанк • Зурьят Гозгешева</div>
                        <p class="pay-subtitle">Отсканируйте QR-код для перевода</p>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- МЕНЮ -->
    <div id="screen-menu" class="screen active">
        <div class="logo">SMART ТАКСИ</div>
        <div class="accordion-container">
            <div class="category" id="cat-movies">
                <div class="category-header" onclick="toggleCategory('cat-movies')">
                    <span>🎬 Фильмы</span>
                    <span class="plus">+</span>
                </div>
                <div class="category-content">
                    <div class="grid" id="grid-movies"></div>
                </div>
            </div>
            <div class="category" id="cat-cartoons">
                <div class="category-header" onclick="toggleCategory('cat-cartoons')">
                    <span>🧸 Мультфильмы</span>
                    <span class="plus">+</span>
                </div>
                <div class="category-content">
                    <div class="grid" id="grid-cartoons"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ВЫБРАННЫЙ ФИЛЬМ -->
    <div id="screen-selected" class="screen">
        <div class="selected-content">
            <div class="selected-icon">🎬</div>
            <h1>Выбран фильм:</h1>
            <h2 id="selected-title">Название</h2>
            <p class="hint">Водитель уже включает его для вас!</p>
        </div>
    </div>

    <!-- ОПЛАТА ПЕРЕВОДОМ (ОТДЕЛЬНЫЙ ЭКРАН) -->
    <div id="screen-tips" class="screen">
        <div class="pay-card">
            <h1 class="pay-title">Оплата поездки</h1>
            
            <div class="tips-content">
                <div class="qr-container">
                    <img src="/img/qr/sber-qr.png" alt="QR Сбер" class="qr-image" onerror="this.src='/img/no-cover.jpg'">
                </div>
                <div class="pay-details">
                    <div class="phone-number">+7 (989) 782-64-05</div>
                    <div class="bank-info">Сбербанк • Зурьят Гозгешева</div>
                    <p class="pay-subtitle">Отсканируйте QR-код для перевода</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ОЦЕНКА 5 ЗВЕЗД (ОТДЕЛЬНЫЙ ЭКРАН) -->
    <div id="screen-rating" class="screen">
        <div class="rating-card">
            <h1>Оцените поездку</h1>
            <p class="rating-subtitle">Поставьте 5 звезд в приложении Maxim</p>
            <div class="stars-container">
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
            </div>
            <p class="greeting">Хорошего Вам дня!</p>
        </div>
    </div>

    <!-- ЧЕРНЫЙ ЭКРАН -->
    <div id="screen-black" class="screen"></div>

    <!-- ПОДКЛЮЧАЕМ СКРИПТЫ -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/screen.js"></script>

</body>
</html>

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Smart Такси</title>
    <link rel="stylesheet" href="/css/screen.css">
</head>
<body>

    <!-- МЕНЮ (Открыто по умолчанию) -->
    <div id="screen-menu" class="screen active">
        <div class="logo fade-up">SMART ТАКСИ</div>
        
        <div class="accordion-container fade-up delay-1">
            <div class="category" id="cat-movies">
                <div class="category-header" onclick="toggleCategory('cat-movies')">
                    <span>🎬 Фильмы</span>
                    <span class="plus">+</span>
                </div>
                <div class="category-content">
                    <div class="grid" id="grid-movies"></div>
                </div>
            </div>

            <div class="category" id="cat-cartoons">
                <div class="category-header" onclick="toggleCategory('cat-cartoons')">
                    <span>🧸 Мультфильмы</span>
                    <span class="plus">+</span>
                </div>
                <div class="category-content">
                    <div class="grid" id="grid-cartoons"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ВЫБРАННЫЙ ФИЛЬМ -->
    <div id="screen-selected" class="screen">
        <div class="selected-icon scale-in">🎬</div>
        <h1 class="fade-up delay-1">Выбран фильм:</h1>
        <h2 id="selected-title" class="fade-up delay-2">Название</h2>
        <p class="hint fade-up delay-3">Водитель уже включает его для вас!</p>
    </div>

    <!-- ОПЛАТА ПЕРЕВОДОМ -->
    <div id="screen-tips" class="screen">
        <div class="pay-card slide-up">
            <h1 class="pay-title">Оплата поездки</h1>
            <div class="pay-divider"></div>
            
            <div class="tips-content">
                <div class="qr-container">
                    <img src="/img/qr/sber-qr.png" alt="QR Сбер" class="qr-image" onerror="this.src='/img/no-cover.jpg'">
                </div>
                <div class="pay-details">
                    <div class="phone-number">+7 (989) 782-64-05</div>
                    <div class="bank-info">Сбербанк • Зурьят Гозгешева</div>
                    <p class="pay-subtitle">Отсканируйте QR-код<br>для перевода</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ОЦЕНКА 5 ЗВЕЗД -->
    <div id="screen-rating" class="screen">
        <div class="rating-card scale-in">
            <h1>Оцените поездку</h1>
            <p class="pay-subtitle" style="margin-bottom: 30px;">Поставьте 5 звезд в приложении Maxim</p>
            <div class="stars-container">
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
                <span class="star">⭐</span>
            </div>
            <p class="greeting">Хорошего Вам дня!</p>
        </div>
    </div>

    <!-- ЧЕРНЫЙ ЭКРАН -->
    <div id="screen-black" class="screen"></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/screen.js"></script>
</body>
</html>

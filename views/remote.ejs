<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Пульт - Smart Такси</title>
    <link rel="stylesheet" href="/css/remote.css">
</head>
<body>
    <h1>Пульт управления</h1>
    
    <div class="control-grid">
        <button id="btn-menu" class="btn-control btn-menu" onclick="sendCommand('go_menu')">
            <span class="icon">📂</span> Меню (Фильмы)
        </button>
        <button id="btn-tips" class="btn-control btn-tips" onclick="sendCommand('show_tips')">
            <span class="icon">💳</span> Оплата (СБП)
        </button>
        <button id="btn-rating" class="btn-control btn-rating" onclick="sendCommand('show_rating')">
            <span class="icon">⭐</span> Оценка (5 звезд)
        </button>
        <button id="btn-stop" class="btn-control btn-stop" onclick="sendCommand('stop_all')">
            <span class="icon">⏹</span> Выключить экран
        </button>
    </div>

    <div style="margin-top: 40px; text-align: center; border-top: 1px solid #2a2a3a; padding-top: 20px;">
        <a href="/admin" style="color: #94a3b8; text-decoration: none; font-size: 16px; display: inline-flex; align-items: center; gap: 8px;">
            ⚙️ Управление фильмами
        </a>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/remote.js"></script>
</body>
</html>

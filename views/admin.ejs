<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Управление фильмами - Smart Такси</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            background: #0f172a; 
            color: #fff; 
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            padding: 20px; 
        }
        h1 { font-size: 24px; margin-bottom: 20px; color: #facc15; text-align: center; }
        h3 { font-size: 18px; margin-bottom: 15px; color: #cbd5e1; }
        
        .card { 
            background: #1e293b; 
            padding: 20px; 
            border-radius: 12px; 
            margin-bottom: 30px; 
            max-width: 500px; 
            margin-left: auto; 
            margin-right: auto;
        }
        
        input, select, button { 
            display: block; 
            width: 100%; 
            padding: 12px; 
            margin-bottom: 15px; 
            border-radius: 8px; 
            border: 1px solid #334155; 
            background: #0f172a; 
            color: #fff; 
            font-size: 16px;
        }
        
        button { 
            background: #10b981; 
            color: white; 
            font-weight: bold; 
            cursor: pointer; 
            border: none;
            transition: background 0.2s;
        }
        
        button:hover { background: #059669; }
        
        .movie-list-container {
            max-width: 600px;
            margin: 0 auto;
        }
        
        .movie-item { 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            background: #1e293b; 
            padding: 12px; 
            margin-bottom: 10px; 
            border-radius: 8px; 
            gap: 15px;
        }
        
        .movie-item img { 
            width: 50px; 
            height: 75px; 
            object-fit: cover; 
            border-radius: 5px; 
        }
        
        .movie-info { flex: 1; }
        .movie-info .title { font-weight: bold; font-size: 16px; }
        .movie-info .category { font-size: 12px; color: #94a3b8; }
        
        .delete-btn { 
            background: #ef4444; 
            width: auto; 
            padding: 8px 15px; 
            margin: 0; 
            font-size: 14px;
        }
        
        .delete-btn:hover { background: #dc2626; }
        
        .back-link {
            display: block;
            text-align: center;
            color: #94a3b8;
            text-decoration: none;
            margin-top: 20px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <h1>⚙️ Управление фильмами</h1>

    <div class="card">
        <h3>Добавить фильм</h3>
        <form id="addForm">
            <input type="text" name="title" placeholder="Название фильма" required>
            <select name="category" required>
                <option value="movies">Фильм</option>
                <option value="cartoons">Мультфильм</option>
            </select>
            <input type="file" name="cover" accept="image/*" required>
            <button type="submit">Добавить</button>
        </form>
    </div>

    <h3 style="text-align: center;">Список фильмов</h3>
    <div class="movie-list-container" id="movieList">
        <!-- Сюда загрузятся фильмы -->
    </div>

    <a href="/remote" class="back-link">← Вернуться на пульт</a>

    <script>
        // Загрузка списка
        async function loadMovies() {
            const res = await fetch('/api/movies');
            const movies = await res.json();
            const list = document.getElementById('movieList');
            list.innerHTML = '';
            
            if (movies.length === 0) {
                list.innerHTML = '<div style="text-align:center; color:#888;">Пока нет добавленных фильмов</div>';
                return;
            }

            movies.forEach(m => {
                const div = document.createElement('div');
                div.className = 'movie-item';
                div.innerHTML = `
                    <img src="${m.cover}" alt="${m.title}" onerror="this.src='/img/no-cover.jpg'">
                    <div class="movie-info">
                        <div class="title">${m.title}</div>
                        <div class="category">${m.category === 'movies' ? 'Фильм' : 'Мультфильм'}</div>
                    </div>
                    <button class="delete-btn" onclick="deleteMovie(${m.id})">Удалить</button>
                `;
                list.appendChild(div);
            });
        }

        // Добавление
        document.getElementById('addForm').onsubmit = async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerText = 'Загрузка...';
            btn.disabled = true;

            try {
                await fetch('/api/movies', { method: 'POST', body: formData });
                e.target.reset();
                loadMovies();
            } catch (err) {
                alert('Ошибка при загрузке');
            } finally {
                btn.innerText = 'Добавить';
                btn.disabled = false;
            }
        };

        // Удаление
        async function deleteMovie(id) {
            if (confirm('Вы уверены, что хотите удалить этот фильм?')) {
                await fetch('/api/movies/' + id, { method: 'DELETE' });
                loadMovies();
            }
        }

        // Запускаем загрузку при открытии
        loadMovies();
    </script>
</body>
</html>